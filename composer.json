{
  "name": "wi-api/php",
  "description": "Official PHP SDK for the wi-api WhatsApp platform",
  "type": "library",
  "license": "MIT",
  "homepage": "https://packagist.org/packages/wi-api/php",
  "keywords": [
    "whatsapp",
    "api",
    "sdk",
    "messaging"
  ],
  "authors": [
    {
      "name": "wi-api",
      "email": "contato@wi.api.br"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11"
  },
  "autoload": {
    "psr-4": {
      "WiApi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WiApi\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "source": {
    "type": "git",
    "url": "https://github.com/wiApi/php",
    "reference": "main"
  },
  "support": {
    "issues": "https://github.com/wiApi/php/issues",
    "source": "https://github.com/wiApi/php"
  }
}
