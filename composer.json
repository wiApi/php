{
  "name": "wi-api/php",
  "description": "Official PHP SDK for the wi-api WhatsApp platform",
  "type": "library",
  "license": "MIT",
  "homepage": "https://docs.wi.api.br",
  "keywords": ["whatsapp", "api", "sdk", "messaging"],
  "authors": [
    {
      "name": "wi-api",
      "email": "contato@wi.api.br"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11"
  },
  "autoload": {
    "psr-4": {
      "WiApi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WiApi\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
